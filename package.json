{
  "name": "swarnpro-erp",
  "private": true,
  "version": "1.0.6",
  "description": "SwarnPro Jewellery ERP System (Tauri v2)",
  "author": "AsyncroZ Technologies",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "bump": "node scripts/bump-version.js",
    "build": "vite build",
    "build:vite": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/bump-version.js patch && tauri build && node scripts/copy-release.js",
    "tauri:build:minor": "node scripts/bump-version.js minor && tauri build && node scripts/copy-release.js",
    "tauri:build:major": "node scripts/bump-version.js major && tauri build && node scripts/copy-release.js",
    "tauri:build:nobump": "tauri build && node scripts/copy-release.js",
    "release": "npm run tauri:build",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
